# Copia a `.env` y rellena los valores (nunca subir `.env` al repositorio).

# --- Django ---
DJANGO_SECRET_KEY=
# En producción debe ser False
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=retegi.eus,www.retegi.eus,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://retegi.eus,https://www.retegi.eus,http://127.0.0.1:8090
DJANGO_LANGUAGE_CODE=es
DJANGO_TIME_ZONE=Europe/Madrid
DJANGO_BASE_URL=https://retegi.eus

# Base de datos (Postgres en producción, o SQLite en volumen Docker)
# Postgres: postgres://USER:PASSWORD@host:5432/NAME
# SQLite en Docker (override típico):
# DATABASE_URL=sqlite:////app/data/db.sqlite3
DATABASE_URL=

# HTTPS detrás de Nginx/proxy: por defecto True cuando DJANGO_DEBUG=False.
# Para probar el contenedor solo en http://127.0.0.1:8090 sin TLS, desactivar:
# DJANGO_SECURE_SSL_REDIRECT=False
# DJANGO_SESSION_COOKIE_SECURE=False
# DJANGO_CSRF_COOKIE_SECURE=False
# DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False

# Puerto en el host (documentación; Gunicorn escucha en 8000 dentro del contenedor).
# El mapeo real es "8090:8000" en docker-compose.prod.yml
PORT=8090

# --- Brevo (contacto); si BREVO_API_KEY está vacío se usa EMAIL_BACKEND ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Retegi
BREVO_TO_EMAIL=

# --- Email genérico Django (SMTP u otro backend) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=
CONTACT_EMAIL=

# --- Integraciones opcionales ---
OPENAI_API_KEY=
SENDGRID_API_KEY=
TINYMCE_API_KEY=

# --- Redis / Celery / Channels (en el mismo host Docker, usar nombre del servicio redis) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
